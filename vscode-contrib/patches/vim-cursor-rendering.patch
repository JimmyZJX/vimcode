+	private _getViewCursorPositionsFromSource(source: string | null | undefined, selectionCount: number): Position[] | undefined {
+		const prefix = 'vim.cursorPositions:';
+		if (!source?.startsWith(prefix)) {
+			return undefined;
+		}
+		const rawPositions = source.slice(prefix.length).split(';').filter(Boolean);
+		if (rawPositions.length !== selectionCount) {
