+	private static _normalizeVimCharacterTarget(ctx: HitTestContext, request: HitTestRequest, target: IMouseTarget): IMouseTarget {
+		if (!MouseTargetFactory._isVimCharacterHitTestingEnabled(ctx)) {
+			return target;
+		}
+
+		// In Vim character mode, mouse targets should describe the character under
+		// the pointer, not the boundary nearest the pointer.  After normalization,
+		// CONTENT_TEXT targets have [position] equal to [range.getStartPosition()].
+		// Downstream code still carries the range so selection drags can choose the
+		// start or end boundary while preserving the original click-count behavior.
+		const range = MouseTargetFactory._vimMouseCharacterRangeForTarget(ctx, request, target);
+		if (range === null) {
+			return target;
+		}
+
+		const position = range.getStartPosition();
+		if (target.type === MouseTargetType.CONTENT_TEXT) {
+			return request.fulfillContentText(position, range, target.detail);
+		}
+		if (target.type === MouseTargetType.CONTENT_EMPTY) {
+			return request.fulfillContentText(position, range, { injectedText: null, mightBeForeignElement: false });
+		}
+		return target;
+	}
+
+	private static _isVimCharacterHitTestingEnabled(ctx: HitTestContext): boolean {
+		return ctx.viewDomNode.closest('.vim-character-mode-enabled') !== null;
+	}
+
+	private static _vimMouseCharacterRangeForTarget(ctx: HitTestContext, request: HitTestRequest, target: IMouseTarget): EditorRange | null {
+		if (target.type === MouseTargetType.CONTENT_TEXT) {
+			if (target.range !== null && !target.range.isEmpty()) {
+				return target.range;
+			}
+			return target.position === null
+				? null
+				: MouseTargetFactory._characterRangeAtMouseOffset(ctx, target.position.lineNumber, target.position.column, request.mouseContentHorizontalOffset);
+		}
+
+		if (target.type === MouseTargetType.CONTENT_EMPTY && target.position !== null && !target.detail.isAfterLines) {
+			const lineMaxColumn = ctx.viewModel.getLineMaxColumn(target.position.lineNumber);
+			if (lineMaxColumn > 1 && target.position.column >= lineMaxColumn) {
+				return new EditorRange(target.position.lineNumber, lineMaxColumn - 1, target.position.lineNumber, lineMaxColumn);
+			}
+		}
+
+		return null;
+	}
+
+	private static _characterRangeAtMouseOffset(ctx: HitTestContext, lineNumber: number, column: number, mouseContentHorizontalOffset: number): EditorRange | null {
+		interface OffsetColumn { offset: number; column: number }
+		const points: OffsetColumn[] = [];
+		const visibleRange = ctx.visibleRangeForPosition(lineNumber, column);
+		if (visibleRange) {
+			points.push({ offset: visibleRange.left, column });
+		}
+		if (column > 1) {
+			const visibleRange = ctx.visibleRangeForPosition(lineNumber, column - 1);
+			if (visibleRange) {
+				points.push({ offset: visibleRange.left, column: column - 1 });
+			}
+		}
+		const lineMaxColumn = ctx.viewModel.getLineMaxColumn(lineNumber);
+		if (column < lineMaxColumn) {
+			const visibleRange = ctx.visibleRangeForPosition(lineNumber, column + 1);
+			if (visibleRange) {
+				points.push({ offset: visibleRange.left, column: column + 1 });
+			}
+		}
+
+		points.sort((a, b) => a.offset - b.offset);
+		for (let i = 1; i < points.length; i++) {
+			const prev = points[i - 1];
+			const curr = points[i];
+			if (prev.offset <= mouseContentHorizontalOffset && mouseContentHorizontalOffset <= curr.offset) {
+				return new EditorRange(lineNumber, prev.column, lineNumber, curr.column);
+			}
+		}
+		return null;
+	}
